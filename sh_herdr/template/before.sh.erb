<%
require "shellwords"

session = context.herdr_session.to_s
workspace = context.sh_workspace.to_s
workspace = "$HOME" if workspace.blank?
%>
export herdr_session=<%= Shellwords.escape(session) %>
export herdr_workspace=<%= Shellwords.escape(workspace) %>
export herdr_job_id="${SLURM_JOB_ID:-}"
export herdr_staging_dir="$PWD"
